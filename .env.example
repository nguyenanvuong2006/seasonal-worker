# Copy this file to .env.local for local development. Never commit the real
# .env / .env.local file — it is already excluded by .gitignore.

# Required. PostgreSQL connection string (Neon, Vercel Postgres, or any
# Postgres-compatible provider). Must include ?sslmode=require for Neon.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required. Random secret used to sign session JWTs. Generate one at
# https://generate-secret.vercel.app/32 (or `openssl rand -base64 32`).
AUTH_SECRET=

# Optional but recommended in production. Bearer token that /api/cron/run
# requires in the Authorization header (Authorization: Bearer <value>).
# If unset, the cron endpoint runs without a secret check.
CRON_SECRET=

# Set automatically by Vercel/Next.js — only needed locally if you want to
# mirror production cookie behavior (Secure cookies require "production").
NODE_ENV=development
