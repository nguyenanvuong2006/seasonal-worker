# Copy this file to .env.local for local development. Never commit the real
# .env / .env.local file — it is already excluded by .gitignore.

# ============================================================
# REQUIRED IN PRODUCTION (set these on Vercel → Project → Settings →
# Environment Variables before deploying)
# ============================================================

# PostgreSQL connection string (Neon, Vercel Postgres, or any
# Postgres-compatible provider). Must include ?sslmode=require for Neon.
# Checked lazily at runtime on first DB access, not at build time — but
# every request that touches the database will fail without it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random secret used to sign/verify session JWTs. Generate one at
# https://generate-secret.vercel.app/32 (or `openssl rand -base64 32`).
# There is no fallback — the app cannot create or verify a session without
# this set, in any environment.
AUTH_SECRET=

# Bearer token required by /api/cron/run (Authorization: Bearer <value>).
CRON_SECRET=

# ============================================================
# DOCUMENT MERGE — Google Docs / Drive
# ============================================================
# Production should use ONE of these durable credential modes.
#
# Option A — Google service account (recommended for server-to-server merge).
# Share each template + output folder with GOOGLE_SERVICE_ACCOUNT_EMAIL.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full PEM private key. Vercel may store newlines as \n; the app normalizes them.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Option B — OAuth refresh token for a dedicated company Google account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Temporary/debug only. A raw access token expires quickly, so do not use this
# as the long-term production configuration.
GOOGLE_ACCESS_TOKEN=

# Tests/local-only escape hatch. NEVER enable in production: mock mode creates
# fake document IDs and is intended only for automated tests.
DOCUMENT_MERGE_USE_MOCK=false

# ============================================================
# DOCUMENT MERGE — ASYNC HTML/PDF ENGINE (Phase 2+)
# ============================================================
# Engine dùng cho batch merge:
#   GOOGLE_DOCS (default) — legacy: copy Google Docs template + replace placeholders.
#                           GIỮ NGUYÊN cho tới khi visual verification + batch test đạt.
#   HTML_PDF              — new engine: HTML/CSS print template → Playwright PDF
#                           trên Cloud Run, chạy bất đồng bộ qua Neon queue.
# Rollback = đổi ENV về GOOGLE_DOCS (không cần revert code).
DOCUMENT_MERGE_ENGINE=GOOGLE_DOCS

# Cloud Run PDF worker (chỉ server, không expose client).
PDF_MERGE_WORKER_URL=
# Bearer token bảo vệ endpoint /run của worker (secret, server-only).
# Khi GOOGLE_WIF_* được cấu hình (Vercel Preview → Cloud Run IAM), secret này
# được gửi ở header X-Merge-Worker-Secret (Authorization bị chiếm bởi Google ID token).
MERGE_WORKER_SECRET=

# ============================================================
# VERCEL OIDC → GOOGLE WORKLOAD IDENTITY FEDERATION (Preview → Cloud Run IAM)
# ============================================================
# Vercel inject token tự động: env VERCEL_OIDC_TOKEN (builds/local) hoặc header
# x-vercel-oidc-token (Vercel Functions) — không cần set thủ công.
# Bật "OIDC Federation" trong Vercel project settings (audience: https://vercel.com/hrstaffing).
GOOGLE_WIF_PROJECT_NUMBER=68054464426
GOOGLE_WIF_POOL_ID=vercel-staging
GOOGLE_WIF_PROVIDER_ID=vercel-preview
# Service account được impersonate để mint Google ID token (aud = Cloud Run URL).
GOOGLE_WIF_SERVICE_ACCOUNT=

# Queue tuning (worker + watchdog).
MERGE_JOB_MAX_ATTEMPTS=3
MERGE_JOB_ITEM_LEASE_SECONDS=60
MERGE_JOB_BATCH_TTL_DAYS=14

# Retention mặc định khi tạo PDF (năm). Template builder có thể cấu hình riêng
# (1/2/3/5/10/none); giá trị này snapshot vào document_history.retention_policy_snapshot.
MERGE_DEFAULT_RETENTION_YEARS=3

# ============================================================
# CLOUD VERIFICATION (CHỈ non-production — staging/preview)
# ============================================================
# Bật trang Diagnostics/Verification (Admin-only) — KHÔNG bật ở production.
VERIFICATION_ENABLED=false

# Storage provider cho PDF: google_drive (production) | local (dev/test).
STORAGE_PROVIDER=google_drive
# Root folder 'Seasonal Worker Documents' trên Google Drive (tạo 1 lần, share
# cho OAuth user). Nếu trống, worker tạo/tự tìm theo cấu trúc chuẩn.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Legacy output folder (tương thích merge/execute cũ).
GOOGLE_DRIVE_OUTPUT_FOLDER_ID=

# Archive Agent (chạy trên máy HR/NAS — không đặt ở Vercel).
ARCHIVE_API_URL=
ARCHIVE_API_KEY=
ARCHIVE_DESTINATION=D:\HR_DOCUMENT_ARCHIVE
ARCHIVE_MANIFEST_INTERVAL=MONTHLY

# ============================================================
# DOCUMENT MERGE — Engine feature flag (safe migration)
# ============================================================
# GOOGLE_DOCS = legacy engine (copy Google Doc + replace placeholders) — DEFAULT.
# HTML_PDF    = new async engine (HTML/CSS print template → Playwright PDF on Cloud Run).
# Admin có thể rollback bằng ENV mà không cần revert code. Sau khi verification
# thành công mới đặt production default = HTML_PDF.
DOCUMENT_MERGE_ENGINE=GOOGLE_DOCS

# ============================================================
# DOCUMENT MERGE — Object storage (individual PDFs / batch PDF / ZIP)
# ============================================================
# local (default, dev/test) | gcs | s3 | vercel-blob (production — Phase 5).
STORAGE_PROVIDER=local
# Chỉ dùng với STORAGE_PROVIDER=local — thư mục gốc lưu file tạm.
STORAGE_LOCAL_ROOT=.storage

# ============================================================
# DOCUMENT MERGE — Playwright worker (Cloud Run, Phase 3)
# ============================================================
# Số render Chromium chạy song song trên 1 worker instance. Không hardcode.
PDF_RENDER_CONCURRENCY=4
# Bearer token worker dùng để gọi các internal endpoint (không phải public endpoint).
MERGE_WORKER_SECRET=
# URL Cloud Run worker (vd https://document-merge-worker-xxx.a.run.app). Vercel gọi
# POST {url}/run sau khi tạo job. Chưa cấu hình = job ở QUEUED (watchdog resume sau).
PDF_MERGE_WORKER_URL=

# ============================================================
# OPTIONAL — AI Workforce Analyst (analytics vẫn chạy nếu chưa cấu hình)
# ============================================================
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# ============================================================
# BOOTSTRAP ONLY — needed for the FIRST deploy only, while the `users`
# table is still empty.
# ============================================================
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# ============================================================
# PROVIDED AUTOMATICALLY BY VERCEL — do not set these yourself.
# ============================================================
# NODE_ENV=production
# VERCEL_ENV=production|preview|development
# VERCEL_REGION=...
# VERCEL_GIT_COMMIT_SHA=...
# VERCEL_GIT_COMMIT_REF=...
