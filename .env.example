# Copy this file to .env.local for local development. Never commit the real
# .env / .env.local file — it is already excluded by .gitignore.

# ============================================================
# REQUIRED IN PRODUCTION (set these on Vercel → Project → Settings →
# Environment Variables before deploying)
# ============================================================

# PostgreSQL connection string (Neon, Vercel Postgres, or any
# Postgres-compatible provider). Must include ?sslmode=require for Neon.
# Checked lazily at runtime on first DB access, not at build time — but
# every request that touches the database will fail without it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random secret used to sign/verify session JWTs. Generate one at
# https://generate-secret.vercel.app/32 (or `openssl rand -base64 32`).
# There is no fallback — the app cannot create or verify a session without
# this set, in any environment.
AUTH_SECRET=

# Bearer token required by /api/cron/run (Authorization: Bearer <value>).
# In production this is REQUIRED — the endpoint fails closed (401) if it's
# missing, instead of running without a secret check. Outside production
# (NODE_ENV != "production") it's optional, for local dev convenience only.
CRON_SECRET=

# ============================================================
# BOOTSTRAP ONLY — needed for the FIRST deploy only, while the `users`
# table is still empty. The app creates exactly one ADMIN account from
# these two values (password hashed with the project's normal scrypt
# hashing, never logged, never returned by any API) the first time `/` or
# /api/health runs with an empty users table. If either variable is
# missing, no account is created and nothing else happens — no hardcoded
# username/password ever exists in this codebase. Once you've logged in
# once, you may delete both variables from Vercel; re-adding them later is
# a no-op because bootstrap only fires when `users` has zero rows.
# ============================================================
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# ============================================================
# PROVIDED AUTOMATICALLY BY VERCEL — do not set these yourself. Listed
# here only because the app reads them (src/app/api/admin/system-stats/route.ts)
# to show build/deploy info on the /admin/system Health Monitor page.
# ============================================================
# NODE_ENV=production
# VERCEL_ENV=production|preview|development
# VERCEL_REGION=...
# VERCEL_GIT_COMMIT_SHA=...
# VERCEL_GIT_COMMIT_REF=...
